# Copy to .env and fill in the two things that have no default:
# GOOGLE_API_KEY (or another provider's key) and GOOGLE_CLOUD_PROJECT.
#
# Commented-out lines show the value already in force, so uncommenting one
# without editing it changes nothing. The two exceptions are marked where they
# appear: LLM_FALLBACKS and LANGSMITH_ENDPOINT are examples, and both default
# to empty.

# --- LLM: pick one provider ---
LLM_PROVIDER=gemini
# gemini: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# openai:      LLM_PROVIDER=openai      + OPENAI_API_KEY=
# openrouter:  LLM_PROVIDER=openrouter  + OPENROUTER_API_KEY=
# ollama:      LLM_PROVIDER=ollama      (no key; needs a local ollama server)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Model overrides are optional; each provider has a sensible default.
# Use the per-provider variable so switching LLM_PROVIDER stays safe — a name
# pinned here is only ever sent to the provider it belongs to.
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OLLAMA_MODEL=llama3.1:8b
#
# LLM_MODEL applies to whichever provider is active, and is never sent to a
# fallback. Prefer the per-provider vars above.
# LLM_MODEL=

# LLM_TEMPERATURE=0.0
#
# LLM_MAX_TOKENS is a cost control, not a length preference. Providers reserve
# credit for the full output ceiling up front, so an unbounded cap makes the
# per-turn cost unbounded — and OpenRouter returns 402 when your balance cannot
# cover the reservation, even for a query that would emit fifty tokens.
# Do not lower it much: below about 4k a reasoning model spends the whole budget
# thinking and is cut off before it writes anything.
# LLM_MAX_TOKENS=8192

# --- Resilience: providers to fall back to when the primary keeps failing ---
# Comma-separated, tried in order. A provider whose key is missing is dropped
# with a warning rather than being fatal. Empty (the default) means no chain.
# Transient failures (429, timeouts, 5xx) are retried on the current provider
# with jittered backoff; a rejected key or an exhausted balance is permanent and
# moves on to the next provider immediately.
# LLM_FALLBACKS=openai,ollama          # example; default is empty
# LLM_RETRY_ATTEMPTS=3

# --- BigQuery ---
# theLook is a PUBLIC dataset, but queries are billed to YOUR project.
# Set this to a GCP project you own, then run:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
# Leave blank to use the default project from your application-default
# credentials. Set it explicitly when you have several.

# BQ_DATASET=bigquery-public-data.thelook_ecommerce
#
# The hard per-query ceiling, enforced by a dry run before anything executes.
# The worst case for one turn is this times MAX_ANALYSIS_STEPS + REPAIR_BUDGET
# + DIAGNOSE_BUDGET — 14 queries, so 28 GB by default. This is the number to
# check against a budget alert.
# BQ_MAX_BYTES_BILLED=2000000000
# BQ_TIMEOUT_SECONDS=60

# --- Query shaping ---
# Rows fetched from a result. Applied when reading, not as a SQL LIMIT: a LIMIT
# truncates server-side and loses the true size of the result, and it saves no
# bytes — BigQuery bills on bytes scanned, measured at 0% on the query that
# exposed this.
# DISPLAY_ROW_LIMIT=500
#
# The SQL-level bound the guard injects: a ceiling against an unbounded result,
# not a display cap. High enough that a realistic analytical result is complete.
# MAX_ROW_LIMIT=100000

# --- Agent budgets: the main cost lever ---
# Worst case per turn is MAX_ANALYSIS_STEPS + REPAIR_BUDGET + DIAGNOSE_BUDGET
# executed queries. Halving MAX_ANALYSIS_STEPS halves the ceiling; the trade is
# that a broad comparison ("compare these five brands") may run out mid-answer.
# MAX_ANALYSIS_STEPS=10
# REPAIR_BUDGET=3
# DIAGNOSE_BUDGET=1

# --- Context ---
# The thread is re-sent whole on every model call and grows ~311 tokens a turn,
# so on a large-window model this never fires. It is here for small local models
# and very long sittings. 0 disables summarization entirely.
# CONTEXT_SUMMARIZE_TRIGGER_TOKENS=30000
# CONTEXT_KEEP_MESSAGES=20

# --- Postgres (docker compose brings this up on 5433, not 5432) ---
# Optional. Without it you lose conversation history across restarts and the
# saved-reports library; the agent still runs and says so on startup.
DATABASE_URL=postgresql://retail:retail@localhost:5433/retail_agent

# --- Observability (optional) ---
# Needs BOTH of these. With only one set, tracing stays off rather than warning
# on every call.
# Note: enabling this sends prompts and query results to LangSmith. Results are
# already PII-masked before the model sees them, but the data does leave the machine.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=retail-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # example; EU region only

# --- Safety ---
# Any random string. Salts the hashing of PII columns, so change it for anything
# real: the default is shared by every checkout of this repo.
PII_SALT=change-me

# --- Golden Bucket: dense retrieval (optional) ---
# Adds a second, semantic ranker over the analyst corpus, fused with the
# lexical one. It finds the trio whose analyst wrote "churned" when the
# executive asks about "shoppers who have gone quiet" — a case no amount of
# keyword matching reaches.
#
# Vectors are stored with pgvector, in the same Postgres that already holds the
# trios, so there is no second database to run. Needs both that database and
# OPENAI_API_KEY; without either it degrades to lexical retrieval, which works
# with nothing installed.
# DENSE_RETRIEVAL=false
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
