# --- LLM: pick one provider ---
LLM_PROVIDER=gemini
# gemini: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# openai:      LLM_PROVIDER=openai      + OPENAI_API_KEY=
# openrouter:  LLM_PROVIDER=openrouter  + OPENROUTER_API_KEY=
# ollama:      LLM_PROVIDER=ollama      (no key; needs a local ollama server)

# Model overrides are optional; each provider has a sensible default.
# Use the per-provider variable so switching LLM_PROVIDER stays safe — a name
# pinned here is only ever sent to the provider it belongs to.
# GEMINI_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-4.1-mini
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OLLAMA_MODEL=llama3.1:8b
#
# LLM_MODEL applies to whichever provider is active. Prefer the vars above.

# --- BigQuery ---
# theLook is a PUBLIC dataset, but queries are billed to YOUR project.
# Set this to a GCP project you own, then run:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=

# --- Postgres (docker compose brings this up on 5433) ---
DATABASE_URL=postgresql://retail:retail@localhost:5433/retail_agent

# --- Observability (optional) ---
# Needs BOTH of these. With only one set, tracing stays off.
# Note: enabling this sends prompts and query results to LangSmith. Results are
# already PII-masked before the model sees them, but the data does leave the machine.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=retail-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for the EU region

# --- Safety ---
# Any random string. Salts the hashing of PII columns.
PII_SALT=change-me
